{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mehmetcam-portfolio-ai",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "keep_vars": true,
  "secrets": {
    "required": [
      "OPENROUTER_API_KEY",
      "ADMIN_TOKEN"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "UNANSWERED_KV",
      "id": "739f9e99e5624333a413443def5cccd2"
    }
  ]
}
